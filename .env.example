# PicoArmy Environment Configuration
# Copy to .env and fill in values

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=picoarmy
POSTGRES_USER=commander
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ── PostgREST ───────────────────────────────────────────
POSTGREST_URL=http://localhost:3000
PGRST_JWT_SECRET=your-jwt-secret-must-be-at-least-32-characters-long

# ── Commander ───────────────────────────────────────────
PORT=4000
PICOARMY_DATA_DIR=./data

# ── Default LLM Provider (for new bots) ────────────────
# Supports any OpenAI-compatible API: OpenRouter, MiniMax, GLM, etc.
OPENAI_API_KEY=your-api-key
OPENAI_API_BASE=https://api.minimax.io/v1
PICOBOT_MODEL=MiniMax-M2

# ── MiniMax ─────────────────────────────────────────────
# Regular API (pay-per-token, OpenAI-compatible)
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_API_BASE=https://api.minimax.io/v1

# Coding Plan (prompt-quota, Anthropic-compatible endpoint)
# Subscribe at https://platform.minimax.io/subscribe/coding-plan
# MINIMAX_CODING_API_KEY=your-minimax-coding-plan-key
# MINIMAX_CODING_API_BASE=https://api.minimax.io/anthropic
# MINIMAX_CODING_MODEL=MiniMax-M2.1

# ── Zhipu GLM ──────────────────────────────────────────
# Regular API (pay-per-token)
# GLM_API_KEY=your-zhipu-key
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4

# Coding Plan (prompt-quota, dedicated endpoint)
# Subscribe at https://z.ai/subscribe
# GLM_CODING_API_KEY=your-glm-coding-plan-key
# GLM_CODING_API_BASE=https://api.z.ai/api/coding/paas/v4
# GLM_CODING_MODEL=glm-4.7

# ── OpenRouter (unified gateway, optional) ──────────────
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
