# Dev Dockerfile — Commander only (Postgres + PostgREST run as separate services)
FROM node:20-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source (volumes will overlay in dev for hot reload)
COPY tsconfig.json ./
COPY src/ ./src/
COPY souls/ ./souls/
COPY swarms/ ./swarms/
COPY mcp-servers.json ./mcp-servers.json

# Build dashboard
WORKDIR /app/src/dashboard
RUN npm ci && npm run build

WORKDIR /app

# Create data dirs
RUN mkdir -p /data/bots /data/pids

EXPOSE 4000

CMD ["npx", "tsx", "src/commander.ts"]
